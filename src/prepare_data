import argparse
import os
import re
import shutil
from pathlib import Path
from typing import List, Tuple

"""
Prepare Cats vs Dogs dataset into ImageFolder structure.

Supports two common Kaggle layouts:

A) Already ImageFolder-style:
   data/raw/train/cats/*.jpg
   data/raw/train/dogs/*.jpg

B) Kaggle "Dogs vs Cats" (competition) raw zip extracted:
   data/raw/train/cat.0.jpg, dog.0.jpg, ...
   data/raw/test/...

This script converts (B) into:
   data/processed/train/cats/*.jpg
   data/processed/train/dogs/*.jpg
and optionally creates a validation split if you want later (training script can also split).

Usage:
  python -m src.prepare_data --raw_dir data/raw --out_dir data/processed --subset 2500
"""

CAT_RE = re.compile(r"^cat\.", re.IGNORECASE)
DOG_RE = re.compile(r"^dog\.", re.IGNORECASE)

def ensure_dir(p: Path) -> None:
    p.mkdir(parents=True, exist_ok=True)

def copy_subset(files: List[Path], dst: Path, max_n: int) -> int:
    ensure_dir(dst)
    n = 0
    for f in files[:max_n]:
        shutil.copy2(f, dst / f.name)
        n += 1
    return n

def main(args: argparse.Namespace) -> None:
    raw = Path(args.raw_dir)
    out = Path(args.out_dir)

    # If already ImageFolder style, just tell the user.
    if (raw / "train" / "cats").exists() and (raw / "train" / "dogs").exists():
        print("Detected ImageFolder structure at data/raw/train/{cats,dogs}. No conversion needed.")
        print("You can train with: python -m src.train --data_dir data/raw")
        return

    train_dir = raw / "train"
    if not train_dir.exists():
        raise FileNotFoundError(f"Could not find raw train folder: {train_dir}")

    all_jpg = sorted([p for p in train_dir.glob("*.jpg")])
    if not all_jpg:
        raise FileNotFoundError(
            f"No .jpg files found in {train_dir}.\n"
            "Make sure you extracted the Kaggle zip into data/raw/ so you have data/raw/train/*.jpg"
        )

    cats = [p for p in all_jpg if CAT_RE.match(p.name)]
    dogs = [p for p in all_jpg if DOG_RE.match(p.name)]

    if not cats or not dogs:
        raise ValueError(
            "Could not identify cats/dogs from filenames. Expected names like cat.0.jpg / dog.0.jpg"
        )

    # Use same count for both classes for balance
    max_each = args.subset if args.subset > 0 else min(len(cats), len(dogs))
    max_each = min(max_each, len(cats), len(dogs))

    dst_train_cats = out / "train" / "cats"
    dst_train_dogs = out / "train" / "dogs"

    n_cats = copy_subset(cats, dst_train_cats, max_each)
    n_dogs = copy_subset(dogs, dst_train_dogs, max_each)

    print(f"Prepared dataset in: {out}")
    print(f"Copied cats={n_cats}, dogs={n_dogs}")
    print("Train with: python -m src.train --data_dir data/processed")

def build_argparser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Prepare Kaggle Cats vs Dogs data into ImageFolder structure")
    p.add_argument("--raw_dir", default="data/raw", help="Raw data directory")
    p.add_argument("--out_dir", default="data/processed", help="Output directory")
    p.add_argument("--subset", type=int, default=2500, help="How many images per class to copy (0 = all)")
    return p

if __name__ == "__main__":
    main(build_argparser().parse_args())
